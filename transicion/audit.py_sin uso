# transicion/audit.py
from __future__ import annotations

import json
from datetime import datetime
from typing import Any, Optional

from transicion.models import SessionLocal, AuditEvent


def log_event(
    user_id: str,
    variant: str,
    event_type: str,
    payload: Optional[dict[str, Any]] = None,
) -> None:
    """Inserta un evento de auditoría (append-only)."""
    db = SessionLocal()
    try:
        ev = AuditEvent(
            ts=datetime.utcnow(),
            user_id=user_id,
            variant=variant,
            event_type=event_type,
            payload_json=json.dumps(payload or {}, ensure_ascii=False),
        )
        db.add(ev)
        db.commit()
    finally:
        db.close()
